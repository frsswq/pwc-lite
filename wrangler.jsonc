// Cloudflare Worker for the pwc-lite JSON API.
// Create the resources once:
//   wrangler d1 create pwc-lite
//   wrangler vectorize create pwc-lite-bge-small --dimensions 384 --metric cosine
// Then put the D1 database ID below and apply the migrations:
//   wrangler d1 migrations apply pwc-lite --remote
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pwc-lite",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pwc-lite",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "pwc-lite-bge-small" }],
  "ai": { "binding": "AI" },
  // One ingest job every 10 minutes. See src/scheduled/scheduled.ts.
  // Set the optional secrets with: wrangler secret put HF_TOKEN, wrangler secret put GITHUB_TOKEN
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "EMBED_MODEL": "bge-small-en-v1.5" },
}
