{
  "name": "pwc-lite",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight headless paper discovery for personal use.",
  "bin": {
    "pwc": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "pwc": "bun src/cli.ts",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
